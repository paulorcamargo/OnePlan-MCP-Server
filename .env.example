# Copie este arquivo para `.env` e preencha. O `.env` NAO vai para o Git.
#
# Cada pessoa usa a PROPRIA chave de API, criada em my.oneplan.ai. Nao compartilhe a sua:
# o rastro de quem fez o que depende disso, e revogar uma chave nao pode derrubar todo mundo.

# Obrigatorios ------------------------------------------------------------
# A chave e o nome dela, exatamente como aparecem no OnePlan. Juntos formam o Basic auth.
ONEPLAN_API_KEY=
ONEPLAN_KEY_NAME=

# Opcionais ---------------------------------------------------------------
# Padrao: https://mygraph.oneplan.ai (host da API REST).
#ONEPLAN_BASE_URL=

# Cookie de sessao do navegador. Habilita as rotas que a chave sozinha nao alcanca.
#ONEPLAN_SESSION_COOKIE=

# SharePoint / Project Online (PWA). As ferramentas sp_* e pwa_* so aparecem com SP_SITE_URL.
#SP_SITE_URL=
#SP_AUTH_METHOD=app
#SP_CLIENT_ID=
#SP_CLIENT_SECRET=
#SP_TENANT_ID=
